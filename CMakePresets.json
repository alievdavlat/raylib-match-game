{
  "version": 3,
  "configurePresets": [
    {
      "name": "msys2",
      "displayName": "MSYS2 (pacman, system-wide packages)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/msys2",
      "environment": {
        "PATH": "C:/msys64/ucrt64/bin;$penv{PATH}"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "C:/msys64/ucrt64/bin/gcc.exe",
        "CMAKE_MAKE_PROGRAM": "C:/msys64/ucrt64/bin/ninja.exe",
        "CMAKE_PREFIX_PATH": "C:/msys64/ucrt64"
      }
    },
    {
      "name": "msys2-release",
      "displayName": "MSYS2 Release (for sharing)",
      "inherits": "msys2",
      "binaryDir": "${sourceDir}/build/msys2-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "vcpkg",
      "displayName": "vcpkg (per-project packages)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/vcpkg",
      "environment": {
        "PATH": "C:/msys64/ucrt64/bin;$penv{PATH}"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-mingw-static",
        "VCPKG_HOST_TRIPLET": "x64-mingw-static",
        "CMAKE_C_COMPILER": "C:/msys64/ucrt64/bin/gcc.exe",
        "CMAKE_MAKE_PROGRAM": "C:/msys64/ucrt64/bin/ninja.exe"
      }
    }
  ],
  "buildPresets": [
    { "name": "msys2", "configurePreset": "msys2" },
    { "name": "msys2-release", "configurePreset": "msys2-release" },
    { "name": "vcpkg", "configurePreset": "vcpkg" }
  ]
}
